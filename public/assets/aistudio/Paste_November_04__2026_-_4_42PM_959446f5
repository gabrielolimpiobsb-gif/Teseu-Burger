import React, { useState, useRef, useEffect, useCallback } from 'react';
import {
  Volume2,
  VolumeX,
  CheckCircle2,
  Sparkles,
  Trophy,
  Flame,
  Heart,
  RotateCcw,
  Lock,
  ChevronRight,
  ShoppingBag,
} from 'lucide-react';

// As 4 variações de doces artesanais
const SWEET_PRIZES = [
  {
    id: 'cookie-supremo',
    tag: 'HOUSE OF COOKIE',
    name: 'Cookie Artesanal',
    subtitle: 'Gotas de Chocolate Belga 80g',
    icon: '🍪',
  },
  {
    id: 'brigadeiro-gourmet',
    tag: 'HOUSE OF CACAU',
    name: 'Brigadeiro Gourmet',
    subtitle: 'Cacau 70% & Granulado Nobre',
    icon: '🍫',
  },
  {
    id: 'brownie-intenso',
    tag: 'HOUSE OF FUDGE',
    name: 'Brownie Supremo',
    subtitle: 'Casquinha Crocante & Meio Amargo',
    icon: '🥮',
  },
  {
    id: 'bombom-especial',
    tag: 'HOUSE OF SWEET',
    name: 'Bombom da Casa',
    subtitle: 'Recheio Cremoso Artesanal',
    icon: '🍬',
  },
];

const ITEM_HEIGHT = 136;
const REEL_REPEAT = 12;
const REEL_STRIP = Array.from({ length: REEL_REPEAT }).flatMap(() => SWEET_PRIZES);
const MAX_SPINS = 3;

export default function CoupleComboWithSlotTab({ onAddComboWithPrize }) {
  // Controle de Abas: 'menu' (Cardápio) | 'couple-combo' (Aba Combo Casal) | 'slot-machine' (Aba Exclusiva da Máquina)
  const [activeTab, setActiveTab] = useState('menu');
  const [slotTabUnlocked, setSlotTabUnlocked] = useState(false);
  const [showIosNotification, setShowIosNotification] = useState(false);

  // Estados da Máquina Caça-Níqueis (3 Rodadas)
  const [spinsLeft, setSpinsLeft] = useState(MAX_SPINS);
  const [rolledHistory, setRolledHistory] = useState([]); // Guarda os doces sorteados nas 3 rodadas
  const [currentPrize, setCurrentPrize] = useState(null);
  const [claimedPrize, setClaimedPrize] = useState(null);

  const [isSpinning, setIsSpinning] = useState(false);
  const [leverPulled, setLeverPulled] = useState(false);
  const [selectedPreview, setSelectedPreview] = useState(null);
  const [soundEnabled, setSoundEnabled] = useState(true);

  const [reelOffsets, setReelOffsets] = useState([0, -ITEM_HEIGHT, -ITEM_HEIGHT * 2]);
  const [reelSpinningState, setReelSpinningState] = useState([false, false, false]);

  const audioCtxRef = useRef(null);
  const canvasRef = useRef(null);

  // Inicializa Web Audio API
  const getAudioContext = () => {
    if (!audioCtxRef.current) {
      const AudioContext = window.AudioContext || window.webkitAudioContext;
      audioCtxRef.current = new AudioContext();
    }
    if (audioCtxRef.current.state === 'suspended') {
      audioCtxRef.current.resume();
    }
    return audioCtxRef.current;
  };

  // Som idêntico ao alerta cristalino de Notificação do iPhone (Tri-tone / Glass Chime)
  const playIosNotificationSound = useCallback(() => {
    if (!soundEnabled) return;
    try {
      const ctx = getAudioContext();
      const notes = [987.77, 1318.51, 1567.98]; // Si5, Mi6, Sol6
      notes.forEach((freq, i) => {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        const start = ctx.currentTime + i * 0.09;

        osc.type = 'sine';
        osc.frequency.setValueAtTime(freq, start);

        gain.gain.setValueAtTime(0, start);
        gain.gain.linearRampToValueAtTime(0.22, start + 0.015);
        gain.gain.exponentialRampToValueAtTime(0.0008, start + 0.45);

        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(start);
        osc.stop(start + 0.48);
      });
    } catch (e) {}
  }, [soundEnabled]);

  // Sons mecânicos da Máquina Caça-Níqueis
  const playLeverSound = useCallback(() => {
    if (!soundEnabled) return;
    try {
      const ctx = getAudioContext();
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = 'sawtooth';
      osc.frequency.setValueAtTime(140, ctx.currentTime);
      osc.frequency.exponentialRampToValueAtTime(320, ctx.currentTime + 0.12);
      osc.frequency.exponentialRampToValueAtTime(90, ctx.currentTime + 0.25);
      gain.gain.setValueAtTime(0.28, ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.26);
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start();
      osc.stop(ctx.currentTime + 0.27);
    } catch (e) {}
  }, [soundEnabled]);

  const playReelTick = useCallback(() => {
    if (!soundEnabled) return;
    try {
      const ctx = getAudioContext();
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = 'triangle';
      osc.frequency.setValueAtTime(680, ctx.currentTime);
      osc.frequency.exponentialRampToValueAtTime(160, ctx.currentTime + 0.025);
      gain.gain.setValueAtTime(0.13, ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.025);
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.start();
      osc.stop(ctx.currentTime + 0.03);
    } catch (e) {}
  }, [soundEnabled]);

  const playReelStopSound = useCallback(
    (reelIndex) => {
      if (!soundEnabled) return;
      try {
        const ctx = getAudioContext();
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        const baseFreq = 110 + reelIndex * 35;
        osc.type = 'square';
        osc.frequency.setValueAtTime(baseFreq, ctx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(45, ctx.currentTime + 0.11);
        gain.gain.setValueAtTime(0.32, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.005, ctx.currentTime + 0.12);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start();
        osc.stop(ctx.currentTime + 0.13);
      } catch (e) {}
    },
    [soundEnabled]
  );

  const playJackpotSound = useCallback(() => {
    if (!soundEnabled) return;
    try {
      const ctx = getAudioContext();
      const notes = [523.25, 659.25, 783.99, 1046.5, 783.99, 1046.5, 1318.5];
      notes.forEach((freq, idx) => {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        const startTime = ctx.currentTime + idx * 0.08;
        osc.type = idx % 2 === 0 ? 'triangle' : 'sine';
        osc.frequency.setValueAtTime(freq, startTime);
        gain.gain.setValueAtTime(0, startTime);
        gain.gain.linearRampToValueAtTime(0.24, startTime + 0.02);
        gain.gain.exponentialRampToValueAtTime(0.001, startTime + 0.55);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(startTime);
        osc.stop(startTime + 0.6);
      });
    } catch (e) {}
  }, [soundEnabled]);

  // Quando o usuário entra na aba do Combo Casal, dispara a notificação estilo iPhone
  const handleSelectCoupleCombo = () => {
    setActiveTab('couple-combo');
    setSlotTabUnlocked(true);

    if (!claimedPrize) {
      setTimeout(() => {
        setShowIosNotification(true);
        playIosNotificationSound();
      }, 450);
    }
  };

  // Quando o usuário clica na notificação do iPhone, abre a Aba Exclusiva da Máquina
  const handleNotificationClick = () => {
    setShowIosNotification(false);
    setActiveTab('slot-machine');
  };

  // Explosão de confetes dourados
  const fireConfetti = () => {
    const canvas = canvasRef.current;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    canvas.width = canvas.offsetWidth;
    canvas.height = canvas.offsetHeight;

    const particles = Array.from({ length: 80 }).map(() => ({
      x: canvas.width / 2,
      y: canvas.height * 0.42,
      vx: (Math.random() - 0.5) * 15,
      vy: (Math.random() - 0.8) * 15,
      size: Math.random() * 8 + 4,
      color: ['#fbbf24', '#f59e0b', '#fef08a', '#dc2626', '#ffffff'][
        Math.floor(Math.random() * 5)
      ],
      rot: Math.random() * 360,
      vRot: (Math.random() - 0.5) * 12,
      gravity: 0.26,
      alpha: 1,
    }));

    const render = () => {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      let active = false;
      particles.forEach((p) => {
        if (p.alpha <= 0.02) return;
        active = true;
        p.x += p.vx;
        p.y += p.vy;
        p.vy += p.gravity;
        p.rot += p.vRot;
        p.alpha -= 0.013;
        ctx.save();
        ctx.globalAlpha = Math.max(0, p.alpha);
        ctx.translate(p.x, p.y);
        ctx.rotate((p.rot * Math.PI) / 180);
        ctx.fillStyle = p.color;
        ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size * 0.6);
        ctx.restore();
      });
      if (active) requestAnimationFrame(render);
    };
    requestAnimationFrame(render);
  };

  // Lógica de giro com 3 rodadas
  const triggerSpin = () => {
    if (isSpinning || spinsLeft <= 0 || claimedPrize) return;

    setSelectedPreview(null);
    setCurrentPrize(null);
    setLeverPulled(true);
    playLeverSound();
    setTimeout(() => setLeverPulled(false), 550);

    setIsSpinning(true);
    setSpinsLeft((prev) => prev - 1);
    setReelSpinningState([true, true, true]);

    const winningIndex = Math.floor(Math.random() * SWEET_PRIZES.length);
    const prize = SWEET_PRIZES[winningIndex];

    const targetIndices = [
      (REEL_REPEAT - 4) * SWEET_PRIZES.length + winningIndex,
      (REEL_REPEAT - 3) * SWEET_PRIZES.length + winningIndex,
      (REEL_REPEAT - 2) * SWEET_PRIZES.length + winningIndex,
    ];

    const durations = [2300, 3400, 4600];
    const startTime = performance.now();
    let lastTickStep = 0;
    const stoppedReels = [false, false, false];

    const easeOutBack = (t) => {
      const c1 = 1.15;
      const c3 = c1 + 1;
      return 1 + c3 * Math.pow(t - 1, 3) + c1 * Math.pow(t - 1, 2);
    };

    const animateReels = (now) => {
      const elapsed = now - startTime;
      const newOffsets = [0, 0, 0];
      let anyStillSpinning = false;

      for (let i = 0; i < 3; i++) {
        const progress = Math.min(elapsed / durations[i], 1);
        const eased = easeOutBack(progress);
        const targetY = -targetIndices[i] * ITEM_HEIGHT;
        newOffsets[i] = targetY * eased;

        if (progress < 1) {
          anyStillSpinning = true;
        } else if (!stoppedReels[i]) {
          stoppedReels[i] = true;
          playReelStopSound(i);
          setReelSpinningState((prev) => {
            const copy = [...prev];
            copy[i] = false;
            return copy;
          });
        }
      }

      const currentTickStep = Math.floor(Math.abs(newOffsets[2]) / (ITEM_HEIGHT * 0.65));
      if (currentTickStep !== lastTickStep && elapsed < durations[2]) {
        lastTickStep = currentTickStep;
        playReelTick();
      }

      setReelOffsets(newOffsets);

      if (anyStillSpinning) {
        requestAnimationFrame(animateReels);
      } else {
        setIsSpinning(false);
        setCurrentPrize(prize);
        setRolledHistory((prev) => [...prev, prize]);
        playJackpotSound();
        fireConfetti();
      }
    };

    requestAnimationFrame(animateReels);
  };

  // Resgata o brinde escolhido e volta para o Combo Casal com o doce anexado
  const handleClaimPrize = (prizeToClaim) => {
    setClaimedPrize(prizeToClaim);
    if (onAddComboWithPrize) {
      onAddComboWithPrize(prizeToClaim);
    }
    setTimeout(() => {
      setActiveTab('couple-combo');
    }, 900);
  };

  return (
    <div className="relative w-full max-w-2xl mx-auto min-h-[680px] rounded-3xl bg-zinc-950 border border-zinc-800 shadow-2xl overflow-hidden font-sans text-white select-none">
      {/* =====================================================================
          NOTIFICAÇÃO ESTILO IPHONE (iOS BANNER POP-UP NO TOPO DA TELA)
      ====================================================================== */}
      <div
        onClick={handleNotificationClick}
        className={`fixed sm:absolute top-4 left-1/2 -translate-x-1/2 z-50 w-[94%] max-w-[410px] cursor-pointer transition-all duration-500 ${
          showIosNotification
            ? 'translate-y-0 opacity-100 scale-100'
            : '-translate-y-32 opacity-0 scale-95 pointer-events-none'
        }`}
        style={{
          transitionTimingFunction: 'cubic-bezier(0.22, 1, 0.36, 1)',
        }}
      >
        <div
          className="flex items-center gap-3.5 px-4 py-3.5 rounded-[26px] border border-white/60 shadow-[0_18px_45px_rgba(0,0,0,0.45)] hover:scale-[1.02] active:scale-[0.98] transition-transform"
          style={{
            background:
              'linear-gradient(135deg, rgba(235, 245, 255, 0.92) 0%, rgba(245, 247, 250, 0.95) 100%)',
            backdropFilter: 'blur(20px)',
            WebkitBackdropFilter: 'blur(20px)',
          }}
        >
          {/* Ícone estilo App iOS com mini-badge circular no canto inferior direito */}
          <div className="relative flex-shrink-0">
            <div className="w-11 h-11 rounded-[12px] bg-zinc-950 flex items-center justify-center shadow-md relative overflow-hidden">
              {/* Anéis coloridos vibrantes inspirados no ícone Fitness do iOS */}
              <div className="w-8 h-8 rounded-full border-[3px] border-pink-500 flex items-center justify-center">
                <div className="w-5 h-5 rounded-full border-[3px] border-lime-400 flex items-center justify-center">
                  <div className="w-2 h-2 rounded-full bg-cyan-400" />
                </div>
              </div>
            </div>
            {/* Mini Badge Circular no canto inferior direito do ícone */}
            <div className="absolute -bottom-1 -right-1 w-4 h-4 rounded-full bg-zinc-200 border border-white shadow flex items-center justify-center text-[9px] text-zinc-700 font-bold">
              🎰
            </div>
          </div>

          {/* Textos da Notificação iOS */}
          <div className="flex-1 min-w-0 text-left leading-tight">
            <div className="flex items-center justify-between">
              <span className="text-[12.5px] font-semibold text-zinc-700 tracking-tight">
                Combo Casal
              </span>
              <span className="text-[11px] text-zinc-500 font-medium">agora</span>
            </div>

            <p className="text-[13.5px] font-bold text-zinc-950 mt-0.5 truncate">
              3 Rodadas de Brinde Liberadas!
            </p>

            <p className="text-[12.5px] text-zinc-800 leading-snug mt-0.5">
              Você ganhou 3 rodadas para escolher seu brinde na máquina retrô! Toque para abrir.
            </p>
          </div>
        </div>
      </div>

      {/* =====================================================================
          BARRA DE NAVEGAÇÃO DE ABAS DO SITE
      ====================================================================== */}
      <div className="relative z-20 flex items-center justify-between px-4 sm:px-6 py-3.5 bg-zinc-900/90 border-b border-zinc-800">
        <div className="flex items-center gap-2 overflow-x-auto">
          <button
            type="button"
            onClick={() => setActiveTab('menu')}
            className={`px-3.5 py-2 rounded-xl text-xs font-bold transition ${
              activeTab === 'menu'
                ? 'bg-zinc-800 text-white shadow'
                : 'text-zinc-400 hover:text-white'
            }`}
          >
            🍔 Cardápio
          </button>

          <button
            type="button"
            onClick={handleSelectCoupleCombo}
            className={`px-3.5 py-2 rounded-xl text-xs font-bold flex items-center gap-1.5 transition ${
              activeTab === 'couple-combo'
                ? 'bg-red-600 text-white shadow-lg shadow-red-600/30'
                : 'bg-red-950/50 text-red-300 border border-red-800/50 hover:bg-red-900/50'
            }`}
          >
            <Heart className="w-3.5 h-3.5 fill-current" />
            Combo Casal
          </button>

          {/* ABA EXCLUSIVA DA MÁQUINA (Só habilita após clicar no Combo Casal) */}
          <button
            type="button"
            disabled={!slotTabUnlocked}
            onClick={() => slotTabUnlocked && setActiveTab('slot-machine')}
            className={`px-3.5 py-2 rounded-xl text-xs font-black flex items-center gap-1.5 transition ${
              !slotTabUnlocked
                ? 'bg-zinc-900 text-zinc-600 border border-zinc-800 cursor-not-allowed'
                : activeTab === 'slot-machine'
                ? 'bg-gradient-to-r from-amber-400 to-yellow-500 text-zinc-950 shadow-lg shadow-amber-500/25'
                : 'bg-amber-500/15 text-amber-300 border border-amber-500/40 animate-pulse'
            }`}
          >
            {slotTabUnlocked ? (
              <>
                <span>🎰 Máquina de Brinde</span>
                <span className="px-1.5 py-0.5 text-[10px] rounded-full bg-zinc-950 text-amber-400">
                  {spinsLeft}x
                </span>
              </>
            ) : (
              <>
                <Lock className="w-3 h-3" />
                <span>Cassino Brinde (Bloqueado)</span>
              </>
            )}
          </button>
        </div>
      </div>

      {/* =====================================================================
          ABA 1: CARDÁPIO GERAL (Gatilho para clicar no Combo Casal)
      ====================================================================== */}
      {activeTab === 'menu' && (
        <div className="p-6 sm:p-8">
          <div className="mb-6">
            <span className="text-xs font-bold uppercase tracking-widest text-amber-400">
              Destaques da Noite
            </span>
            <h1 className="text-2xl sm:text-3xl font-black mt-1">
              ESCOLHA SEU COMBO
            </h1>
            <p className="text-xs text-zinc-400 mt-1">
              Selecione o Combo Casal para desbloquear a experiência VIP com 3 rodadas de sobremesa grátis!
            </p>
          </div>

          <div className="grid gap-4">
            {/* Card do Combo Casal */}
            <div
              onClick={handleSelectCoupleCombo}
              className="group relative overflow-hidden rounded-2xl bg-gradient-to-br from-red-950/80 via-zinc-900 to-zinc-900 border-2 border-red-600/60 p-5 cursor-pointer hover:border-amber-400 transition-all shadow-xl"
            >
              <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div className="space-y-2">
                  <div className="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-red-600 text-white text-[10px] font-black uppercase tracking-wider">
                    <Flame className="w-3 h-3 fill-current" />
                    Libera Mini-Game + Brinde
                  </div>
                  <h2 className="text-xl font-black text-white group-hover:text-amber-300 transition">
                    Combo Casal Supremo 🍔🍔 + 🍟 + 🥤🥤
                  </h2>
                  <p className="text-xs text-zinc-300 leading-relaxed max-w-md">
                    2 Smash Burgers Artesanais Duplos + Porção Grande de Fritas Crocantes + 2 Bebidas +{' '}
                    <strong className="text-amber-300">
                      3 Rodadas na Máquina Retrô para ganhar 1 Doce Artesanal!
                    </strong>
                  </p>
                </div>

                <div className="flex sm:flex-col items-center sm:items-end justify-between border-t sm:border-t-0 border-zinc-800 pt-3 sm:pt-0">
                  <div className="text-left sm:text-right">
                    <span className="text-[11px] text-zinc-400 line-through">
                      R$ 94,90
                    </span>
                    <p className="text-2xl font-black text-amber-400">R$ 79,90</p>
                  </div>

                  <span className="mt-2 inline-flex items-center gap-1 px-4 py-2 rounded-xl bg-red-600 group-hover:bg-amber-400 group-hover:text-zinc-950 text-white font-black text-xs uppercase tracking-wider transition">
                    Abrir Combo Casal
                    <ChevronRight className="w-4 h-4" />
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* =====================================================================
          ABA 2: PÁGINA INTERNA DO COMBO CASAL (Onde chega a Notificação do iPhone)
      ====================================================================== */}
      {activeTab === 'couple-combo' && (
        <div className="p-6 sm:p-8 space-y-6 animate-fade-in">
          <div className="rounded-2xl bg-gradient-to-b from-red-950/60 to-zinc-900 border border-red-800/40 p-5 sm:p-6">
            <div className="flex flex-wrap items-center justify-between gap-2 mb-3">
              <span className="px-3 py-1 rounded-full bg-red-600/20 border border-red-500/40 text-red-300 text-xs font-bold uppercase tracking-wider">
                ❤️ Aba do Combo Casal
              </span>
              <span className="text-2xl font-black text-amber-400">R$ 79,90</span>
            </div>

            <h2 className="text-2xl font-black text-white">
              Combo Casal Supremo
            </h2>
            <p className="text-xs sm:text-sm text-zinc-300 mt-1">
              2 Burgers Artesanais + Batata Grande Compartilhada + 2 Refrigerantes Lata.
            </p>

            {/* Status do Brinde do Casal */}
            <div className="mt-6 p-4 rounded-xl bg-zinc-950/90 border border-amber-500/40 flex flex-col sm:flex-row items-center justify-between gap-4">
              {claimedPrize ? (
                <>
                  <div className="flex items-center gap-3">
                    <span className="text-4xl">{claimedPrize.icon}</span>
                    <div>
                      <span className="text-[10px] font-black uppercase tracking-widest text-emerald-400">
                        ✓ Brinde Garantido no Combo
                      </span>
                      <h4 className="text-base font-black text-white">
                        {claimedPrize.name} (R$ 0,00)
                      </h4>
                      <p className="text-xs text-zinc-400">
                        {claimedPrize.subtitle}
                      </p>
                    </div>
                  </div>
                  <button
                    type="button"
                    onClick={() => setActiveTab('slot-machine')}
                    className="px-3 py-2 rounded-lg bg-zinc-800 text-zinc-300 text-xs font-bold hover:text-white transition"
                  >
                    Ver Máquina
                  </button>
                </>
              ) : (
                <>
                  <div className="flex items-center gap-3 text-left">
                    <div className="w-12 h-12 rounded-xl bg-amber-500/10 border border-amber-500/40 flex items-center justify-center text-2xl animate-bounce">
                      🎰
                    </div>
                    <div>
                      <span className="text-[11px] font-extrabold uppercase tracking-wider text-amber-400">
                        Brinde Pendente • {spinsLeft} Rodadas Grátis
                      </span>
                      <h4 className="text-sm font-bold text-white">
                        Toque na notificação acima ou no botão ao lado para girar a Máquina!
                      </h4>
                    </div>
                  </div>

                  <button
                    type="button"
                    onClick={handleNotificationClick}
                    className="w-full sm:w-auto px-4 py-2.5 rounded-xl bg-gradient-to-r from-amber-400 to-yellow-500 text-zinc-950 font-black text-xs uppercase tracking-wider shadow-lg hover:brightness-110 transition whitespace-nowrap"
                  >
                    Ir para a Máquina 🎰
                  </button>
                </>
              )}
            </div>

            {/* Botão Final de Adicionar o Combo Casal ao Pedido */}
            <button
              type="button"
              className="mt-6 w-full py-4 rounded-xl bg-red-600 hover:bg-red-500 text-white font-black text-sm uppercase tracking-wider shadow-lg flex items-center justify-center gap-2 transition"
            >
              <ShoppingBag className="w-4 h-4" />
              {claimedPrize
                ? `Finalizar Combo Casal + ${claimedPrize.name} Grátis`
                : 'Finalizar Combo Casal (Escolha seu brinde antes!)'}
            </button>
          </div>
        </div>
      )}

      {/* =====================================================================
          ABA 3: ABA EXCLUSIVA DA MÁQUINA CAÇA-NÍQUEIS RETRÔ (3 RODADAS)
      ====================================================================== */}
      {activeTab === 'slot-machine' && (
        <div className="relative py-6 px-4 sm:px-8 bg-[#041d15] min-h-[620px] overflow-hidden animate-fade-in">
          {/* Cortina de Veludo Verde Escuro ao Fundo */}
          <div
            className="pointer-events-none absolute inset-0 opacity-60"
            style={{
              backgroundImage:
                'repeating-linear-gradient(90deg, #02120c 0px, #072c1f 40px, #031810 80px)',
            }}
          />
          <div className="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_center,transparent_20%,rgba(0,0,0,0.85)_100%)]" />

          {/* Canvas de Confetes */}
          <canvas
            ref={canvasRef}
            className="pointer-events-none absolute inset-0 z-50 w-full h-full"
          />

          {/* Topo com Indicador das 3 Rodadas do Casal */}
          <div className="relative z-20 text-center mb-5">
            <div className="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-red-950/90 border border-amber-500/40 text-amber-300 text-xs font-black uppercase tracking-widest mb-2 shadow">
              <Sparkles className="w-3.5 h-3.5 text-amber-400 animate-pulse" />
              Rodadas Restantes: {spinsLeft} de {MAX_SPINS}
            </div>

            {/* Pílulas das 3 Rodadas */}
            <div className="flex items-center justify-center gap-2 mt-1">
              {[0, 1, 2].map((roundIdx) => {
                const rolledItem = rolledHistory[roundIdx];
                return (
                  <div
                    key={roundIdx}
                    className={`px-3 py-1 rounded-lg text-[11px] font-bold border flex items-center gap-1.5 ${
                      rolledItem
                        ? 'bg-amber-500/20 border-amber-400 text-amber-200'
                        : 'bg-zinc-900/80 border-zinc-700 text-zinc-400'
                    }`}
                  >
                    <span>Rodada {roundIdx + 1}:</span>
                    <span>{rolledItem ? `${rolledItem.icon} ${rolledItem.name.split(' ')[0]}` : '🎲'}</span>
                  </div>
                );
              })}
            </div>
          </div>

          {/* GABINETE DA MÁQUINA RETRÔ VERMELHA + ALAVANCA */}
          <div className="relative z-20 flex items-center justify-center pr-7 sm:pr-12">
            <div
              className="relative w-full max-w-[365px] rounded-t-[54px] rounded-b-[26px] p-4 sm:p-5"
              style={{
                background:
                  'linear-gradient(145deg, #d91b22 0%, #9e0b12 45%, #5c0408 100%)',
                boxShadow: `
                  0 30px 60px rgba(0,0,0,0.85),
                  inset 0 4px 10px rgba(255,255,255,0.55),
                  inset 6px 0 15px rgba(255,140,140,0.25),
                  inset -8px -10px 20px rgba(35,0,0,0.8)
                `,
                border: '2px solid #7f1d1d',
              }}
            >
              {/* Topo Curvo Brilhante */}
              <div
                className="rounded-t-[42px] rounded-b-[18px] p-3 sm:p-4"
                style={{
                  background: 'linear-gradient(180deg, #b80f16 0%, #7d080d 100%)',
                  boxShadow:
                    'inset 0 6px 12px rgba(255,255,255,0.35), 0 6px 14px rgba(0,0,0,0.6)',
                }}
              >
                {/* Moldura Cromada */}
                <div
                  className="rounded-xl p-2 sm:p-2.5"
                  style={{
                    background:
                      'linear-gradient(135deg, #f4f4f5 0%, #71717a 25%, #e4e4e7 50%, #27272a 78%, #d4d4d8 100%)',
                    boxShadow:
                      '0 8px 20px rgba(0,0,0,0.8), inset 0 2px 3px rgba(255,255,255,0.9)',
                  }}
                >
                  {/* Caixa dos 3 Cilindros */}
                  <div className="relative h-[168px] rounded-lg bg-zinc-950 p-2 overflow-hidden shadow-[inset_0_12px_28px_rgba(0,0,0,0.95)] border border-zinc-800">
                    <div className="pointer-events-none absolute top-1/2 left-0 right-0 -translate-y-1/2 h-[2px] bg-red-600/35 z-30" />

                    <div className="grid grid-cols-3 gap-2 h-full">
                      {[0, 1, 2].map((reelIdx) => (
                        <div
                          key={reelIdx}
                          className="relative h-full rounded-md overflow-hidden border-x-2 border-zinc-900"
                          style={{ backgroundColor: '#ebd9b4' }}
                        >
                          <div
                            className={`w-full will-change-transform ${
                              reelSpinningState[reelIdx] ? 'blur-[0.7px]' : ''
                            }`}
                            style={{
                              transform: `translateY(${reelOffsets[reelIdx] + 8}px)`,
                            }}
                          >
                            {REEL_STRIP.map((sweet, idx) => (
                              <div
                                key={idx}
                                style={{ height: `${ITEM_HEIGHT}px` }}
                                className="w-full flex flex-col items-center justify-center px-1.5 py-2 border-b border-amber-900/15"
                              >
                                <div className="w-full h-[108px] rounded bg-[#fbf3e4] border border-[#b91c1c]/40 shadow-sm flex flex-col items-center justify-between p-1.5">
                                  <div className="w-full bg-[#b91c1c] text-[#fbf3e4] text-[8px] font-black tracking-widest uppercase text-center py-0.5 rounded-t-sm">
                                    {sweet.tag}
                                  </div>
                                  <div className="my-auto flex flex-col items-center">
                                    <span className="text-3xl">{sweet.icon}</span>
                                  </div>
                                  <div className="w-full border-t border-[#b91c1c]/30 pt-0.5 text-center">
                                    <p className="text-[9px] font-black uppercase tracking-tighter text-[#991b1b] leading-none">
                                      {sweet.name}
                                    </p>
                                  </div>
                                </div>
                              </div>
                            ))}
                          </div>

                          {/* Sombreamento Cilíndrico 3D */}
                          <div
                            className="pointer-events-none absolute inset-0 z-20"
                            style={{
                              background:
                                'linear-gradient(180deg, rgba(0,0,0,0.88) 0%, rgba(0,0,0,0.28) 22%, rgba(255,255,255,0.22) 50%, rgba(0,0,0,0.28) 78%, rgba(0,0,0,0.88) 100%)',
                            }}
                          />
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              </div>

              {/* BANCADA DE BOTÕES CROMADOS */}
              <div
                className="mt-3 px-3 py-3 rounded-xl flex items-center justify-between"
                style={{
                  background:
                    'linear-gradient(180deg, #6e060a 0%, #990d13 45%, #5e0508 100%)',
                  boxShadow:
                    'inset 0 3px 6px rgba(0,0,0,0.6), 0 2px 3px rgba(255,255,255,0.2)',
                }}
              >
                {/* 4 Botões Quadrados Cromados */}
                <div className="flex items-center gap-1.5">
                  {SWEET_PRIZES.map((item) => {
                    const isSelected = selectedPreview?.id === item.id;
                    return (
                      <button
                        key={item.id}
                        type="button"
                        onClick={() =>
                          setSelectedPreview(isSelected ? null : item)
                        }
                        className={`w-9 h-9 rounded-md p-[2px] transition-transform active:translate-y-0.5 ${
                          isSelected ? 'translate-y-0.5 ring-2 ring-amber-300' : ''
                        }`}
                        style={{
                          background:
                            'linear-gradient(145deg, #ffffff 0%, #71717a 50%, #27272a 100%)',
                          boxShadow: '0 4px 6px rgba(0,0,0,0.7)',
                        }}
                      >
                        <div
                          className="w-full h-full rounded-[4px] flex items-center justify-center text-base"
                          style={{
                            background:
                              'linear-gradient(180deg, #e4e4e7 0%, #a1a1aa 50%, #71717a 100%)',
                          }}
                        >
                          {item.icon}
                        </div>
                      </button>
                    );
                  })}
                </div>

                {/* Botão Cromado de Som */}
                <button
                  type="button"
                  onClick={() => setSoundEnabled(!soundEnabled)}
                  className="w-7 h-7 rounded-full p-[2px]"
                  style={{
                    background:
                      'linear-gradient(145deg, #f4f4f5, #52525b, #18181b)',
                    boxShadow: '0 3px 6px rgba(0,0,0,0.8)',
                  }}
                >
                  <div className="w-full h-full rounded-full bg-gradient-to-b from-zinc-300 to-zinc-600 flex items-center justify-center text-zinc-900">
                    {soundEnabled ? (
                      <Volume2 className="w-3.5 h-3.5" />
                    ) : (
                      <VolumeX className="w-3.5 h-3.5 text-red-800" />
                    )}
                  </div>
                </button>

                {/* Botão Redondo Cromado SPIN */}
                <button
                  type="button"
                  onClick={triggerSpin}
                  disabled={isSpinning || spinsLeft <= 0 || Boolean(claimedPrize)}
                  className={`w-14 h-11 rounded-full p-1 transition-all ${
                    isSpinning || spinsLeft <= 0 || claimedPrize
                      ? 'opacity-60 cursor-not-allowed'
                      : 'hover:brightness-110 active:translate-y-1 cursor-pointer'
                  }`}
                  style={{
                    background:
                      'linear-gradient(145deg, #ffffff 0%, #71717a 45%, #18181b 100%)',
                    boxShadow: '0 6px 10px rgba(0,0,0,0.85)',
                  }}
                >
                  <div
                    className="w-full h-full rounded-full flex items-center justify-center font-black text-[10px] tracking-wider text-zinc-900 uppercase"
                    style={{
                      background:
                        'radial-gradient(circle at 35% 30%, #ffffff 0%, #d4d4d8 40%, #52525b 100%)',
                    }}
                  >
                    {isSpinning ? '...' : spinsLeft > 0 ? `GIRO (${spinsLeft})` : 'FIM'}
                  </div>
                </button>
              </div>

              {/* GAVETA INFERIOR DE RESGATE E RE-GIRO */}
              <div
                className="mt-3 rounded-2xl p-4 flex flex-col items-center justify-center"
                style={{
                  background: 'linear-gradient(180deg, #87090e 0%, #630509 100%)',
                  boxShadow:
                    'inset 0 4px 12px rgba(0,0,0,0.75), 0 2px 2px rgba(255,255,255,0.2)',
                  border: '1px solid #450a0a',
                }}
              >
                {/* Boca da Gaveta Cromada */}
                <div
                  className="w-44 h-10 rounded-lg p-1.5"
                  style={{
                    background:
                      'linear-gradient(135deg, #f4f4f5 0%, #52525b 45%, #e4e4e7 70%, #18181b 100%)',
                    boxShadow: '0 6px 14px rgba(0,0,0,0.8)',
                  }}
                >
                  <div className="w-full h-full rounded bg-zinc-950 flex items-center justify-center">
                    <span className="text-[10px] font-black tracking-widest uppercase text-amber-400">
                      {isSpinning
                        ? 'SORTEANDO...'
                        : currentPrize
                        ? '★ DOCE SORTEADO ★'
                        : `PUXE A ALAVANCA (${spinsLeft}X)`}
                    </span>
                  </div>
                </div>

                {/* Card do Doce Sorteado com opção de Resgatar ou Usar Próxima Rodada */}
                {currentPrize && !isSpinning && (
                  <div className="w-full mt-3.5 p-4 rounded-xl bg-[#fbf3e4] text-zinc-900 border-2 border-amber-500 shadow-2xl text-center animate-fade-in">
                    <div className="inline-flex items-center gap-1 px-2.5 py-0.5 rounded bg-[#b91c1c] text-[#fbf3e4] text-[10px] font-black uppercase tracking-widest">
                      <Trophy className="w-3 h-3" />
                      Rodada {MAX_SPINS - spinsLeft} de {MAX_SPINS}
                    </div>

                    <div className="text-4xl my-1">{currentPrize.icon}</div>
                    <h3 className="text-base font-black uppercase text-[#7f1d1d]">
                      {currentPrize.name}
                    </h3>
                    <p className="text-[11px] text-zinc-600 mb-3">
                      {currentPrize.subtitle}
                    </p>

                    <div className="space-y-2">
                      <button
                        type="button"
                        onClick={() => handleClaimPrize(currentPrize)}
                        className="w-full py-2.5 px-4 rounded-lg bg-gradient-to-r from-[#b91c1c] via-[#dc2626] to-[#991b1b] text-white font-black text-xs uppercase tracking-wider shadow hover:brightness-110 transition flex items-center justify-center gap-1.5"
                      >
                        <CheckCircle2 className="w-4 h-4" />
                        Quero Este Brinde no Combo!
                      </button>

                      {spinsLeft > 0 && (
                        <button
                          type="button"
                          onClick={triggerSpin}
                          className="w-full py-2 px-3 rounded-lg bg-zinc-900 text-amber-300 font-bold text-[11px] uppercase tracking-wider hover:bg-zinc-800 transition flex items-center justify-center gap-1.5"
                        >
                          <RotateCcw className="w-3.5 h-3.5" />
                          Tentar Outro Doce (Restam {spinsLeft}{' '}
                          {spinsLeft === 1 ? 'rodada' : 'rodadas'})
                        </button>
                      )}
                    </div>
                  </div>
                )}
              </div>
            </div>

            {/* ALAVANCA LATERAL CROMADA COM BOLA VERMELHA */}
            <div className="relative h-64 w-10 sm:w-12 flex flex-col items-center justify-end -ml-1">
              <div
                onClick={triggerSpin}
                title="Puxar Alavanca"
                className={`origin-bottom transition-all duration-300 ${
                  isSpinning || spinsLeft <= 0
                    ? 'cursor-not-allowed'
                    : 'cursor-pointer group'
                }`}
                style={{
                  transform: leverPulled
                    ? 'translateY(65px) scaleY(0.55) rotate(12deg)'
                    : 'translateY(0px) scaleY(1) rotate(5deg)',
                }}
              >
                <div
                  className="w-11 h-11 sm:w-12 sm:h-12 rounded-full -mb-2 mx-auto relative z-20 transition-transform group-hover:scale-110"
                  style={{
                    background:
                      'radial-gradient(circle at 32% 30%, #ff8a8a 0%, #dc2626 30%, #991b1b 70%, #450a0a 100%)',
                    boxShadow: '0 8px 18px rgba(0,0,0,0.8)',
                  }}
                />
                <div
                  className="w-3 sm:w-3.5 h-40 mx-auto rounded-full"
                  style={{
                    background:
                      'linear-gradient(90deg, #52525b 0%, #fafafa 45%, #27272a 85%, #a1a1aa 100%)',
                    boxShadow: '4px 6px 12px rgba(0,0,0,0.75)',
                  }}
                />
              </div>

              <div
                className="w-8 sm:w-10 h-16 rounded-r-xl -mt-3 relative z-10"
                style={{
                  background:
                    'linear-gradient(180deg, #e4e4e7 0%, #71717a 35%, #27272a 75%, #a1a1aa 100%)',
                  boxShadow:
                    '6px 10px 20px rgba(0,0,0,0.85), inset -2px 2px 4px rgba(255,255,255,0.7)',
                  borderLeft: '2px solid #18181b',
                }}
              />
            </div>
          </div>
        </div>
      )}
    </div>
  );
}