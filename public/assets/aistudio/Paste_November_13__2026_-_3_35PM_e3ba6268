    function updateHeaderMetrics() {
      // Critical stock count
      const criticalCount = appState.ingredients.filter(i => i.stockBase <= i.minBase).length;
      const critEl = document.getElementById('headerCriticalCount');
      const critIcon = document.getElementById('headerAlertIcon');
      critEl.textContent = `${criticalCount} ${criticalCount === 1 ? 'insumo' : 'insumos'}`;
      if (criticalCount > 0) {
        critEl.className = 'font-bold text-amber-400';
        critIcon.className = 'fa-solid fa-triangle-exclamation text-amber-400 text-sm animate-bounce';
      } else {
        critEl.className = 'font-bold text-emerald-400';
        critIcon.className = 'fa-solid fa-circle-check text-emerald-400 text-sm';
      }

      // Total financial value currently in stock
      const totalStockVal = appState.ingredients.reduce((acc, ing) => acc + (ing.stockBase * ing.costPerBase), 0);
      document.getElementById('headerTotalStockValue').textContent = formatCurrency(totalStockVal);

      // Today's CMV cost
      const startOfDay = new Date();
      startOfDay.setHours(0, 0, 0, 0);
      const todayLogs = appState.logs.filter(l => l.timestamp >= startOfDay.getTime());
      const todayCost = todayLogs.reduce((acc, l) => acc + l.totalCost, 0);
      document.getElementById('headerTodayCost').textContent = formatCurrency(todayCost);

      // Queue badge
      const badge = document.getElementById('kdsQueueBadge');
      badge.textContent = appState.kdsQueue.length;
    }

    // ============================================================================
    // 4. LÓGICA DO KDS / COZINHA E DESCONTO AUTOMÁTICO DE ESTOQUE
    // ============================================================================
    function calculateRecipeCMV(recipe) {
      let total = 0;
      recipe.items.forEach(item => {
        const ing = appState.ingredients.find(i => i.id === item.ingredientId);
        if (ing) {
          const baseNeed = toBaseAmount(item.qty, item.unit);
          total += baseNeed * ing.costPerBase;
        }
      });
      return total;
    }

    // Calcula todos os insumos necessários para uma lista de [{recipeId, qty}]
    function aggregateOrderIngredients(orderItems) {
      const map = {};
      orderItems.forEach(orderItem => {
        const recipe = appState.recipes.find(r => r.id === orderItem.recipeId);
        if (!recipe) return;
        recipe.items.forEach(rItem => {
          const ing = appState.ingredients.find(i => i.id === rItem.ingredientId);
          if (!ing) return;
          const baseQtyNeeded = toBaseAmount(rItem.qty, rItem.unit) * orderItem.qty;
          if (!map[ing.id]) {
            map[ing.id] = {
              ingredient: ing,
              baseNeeded: 0
            };
          }
          map[ing.id].baseNeeded += baseQtyNeeded;
        });
      });

      return Object.values(map).map(entry => {
        const ing = entry.ingredient;
        const currentBase = ing.stockBase;
        const remainingBase = currentBase - entry.baseNeeded;
        const cost = entry.baseNeeded * ing.costPerBase;
        return {
          ingredient: ing,
          baseNeeded: entry.baseNeeded,
          currentBase,
          remainingBase,
          cost,
          hasEnough: remainingBase >= 0
        };
      });
    }

    function renderKdsSection() {
      document.getElementById('builderOrderNumber').textContent = `#${appState.nextOrderCounter}`;

      // Populate recipe dropdown in builder
      const select = document.getElementById('kdsRecipeSelect');
      const prevVal = select.value;
      select.innerHTML = appState.recipes.map(r => {
        const cmv = calculateRecipeCMV(r);
        return `<option value="${r.id}">${r.name} — Venda: ${formatCurrency(r.price)} (CMV: ${formatCurrency(cmv)})</option>`;
      }).join('');
      if (prevVal && appState.recipes.some(r => r.id === prevVal)) {
        select.value = prevVal;
      }

      // Initialize default builder cart if empty on first load
      if (kdsBuilderCart.length === 0 && appState.recipes.length > 0) {
        kdsBuilderCart = [{ recipeId: appState.recipes[0].id, qty: 1 }];
      }

      renderBuilderCartAndPreview();
      renderActiveKdsQueue();
      renderRecentKdsLogs();
    }

    function renderBuilderCartAndPreview() {
      const cartEl = document.getElementById('kdsBuilderCartList');
      if (kdsBuilderCart.length === 0) {
        cartEl.innerHTML = `<p class="text-xs text-stone-400 text-center py-3">Nenhum item adicionado na comanda.</p>`;
      } else {
        cartEl.innerHTML = kdsBuilderCart.map((cItem, idx) => {
          const rec = appState.recipes.find(r => r.id === cItem.recipeId);
          if (!rec) return '';
          return `
            <div class="flex items-center justify-between bg-stone-50 px-3 py-2 rounded-lg border border-stone-200 text-xs">
              <div>
                <span class="font-bold text-teseu-crimson">${cItem.qty}x</span>
                <strong class="text-stone-800 ml-1">${rec.name}</strong>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-stone-600 font-semibold">${formatCurrency(rec.price * cItem.qty)}</span>
                <button onclick="removeItemFromBuilder(${idx})" class="text-stone-400 hover:text-red-600">
                  <i class="fa-solid fa-trash-can"></i>
                </button>
              </div>
            </div>
          `;
        }).join('');
      }

      // Live Deduction Preview
      const previewEl = document.getElementById('kdsDeductionPreviewList');
      const breakdown = aggregateOrderIngredients(kdsBuilderCart);
      let totalCost = 0;

      if (breakdown.length === 0) {
        previewEl.innerHTML = `<p class="text-stone-400">Adicione um lanche acima para ver o cálculo de insumos.</p>`;
      } else {
        previewEl.innerHTML = breakdown.map(item => {
          totalCost += item.cost;
          const ing = item.ingredient;
          const baseUnit = getBaseUnitSymbol(ing.baseType);
          const beforeFormatted = formatDualStock(item.currentBase, ing.displayUnit, ing.baseType).primary;
          const afterFormatted = formatDualStock(Math.max(0, item.remainingBase), ing.displayUnit, ing.baseType).primary;

          return `
            <div class="flex items-center justify-between py-1 border-b border-stone-700/60 last:border-none">
              <div>
                <span class="text-stone-200 font-medium">${ing.name}</span>
                <span class="block text-[11px] text-stone-400">
                  Estoque: ${beforeFormatted} &rarr; <strong class="${item.hasEnough ? 'text-emerald-400' : 'text-red-400'}">${afterFormatted}</strong>
                </span>
              </div>
              <div class="text-right">
                <span class="px-2 py-0.5 rounded bg-teseu-crimson text-teseu-goldLight font-bold">
                  -${item.baseNeeded.toLocaleString('pt-BR')} ${baseUnit}
                </span>
                <span class="block text-[10px] text-stone-400 mt-0.5">${formatCurrency(item.cost)}</span>
              </div>
            </div>
          `;
        }).join('');
      }

      document.getElementById('kdsPreviewTotalCost').textContent = `CMV do Pedido: ${formatCurrency(totalCost)}`;
    }

    function addItemToBuilder() {
      const select = document.getElementById('kdsRecipeSelect');
      const qtyInput = document.getElementById('kdsRecipeQty');
      const recipeId = select.value;
      const qty = Math.max(1, parseInt(qtyInput.value) || 1);

      const existing = kdsBuilderCart.find(i => i.recipeId === recipeId);
      if (existing) {
        existing.qty += qty;
      } else {
        kdsBuilderCart.push({ recipeId, qty });
      }
      qtyInput.value = 1;
      renderBuilderCartAndPreview();
    }

    function removeItemFromBuilder(idx) {
      kdsBuilderCart.splice(idx, 1);
      renderBuilderCartAndPreview();
    }

    function sendBuilderToQueue() {
      if (kdsBuilderCart.length === 0) {
        showToast('Adicione pelo menos 1 item ao pedido!', 'warning');
        return;
      }
      const customer = document.getElementById('kdsCustomerName').value.trim() || 'Balcão Teseu';
      const channel = document.getElementById('kdsOrderChannel').value;

      appState.kdsQueue.push({
        id: 'q_' + Date.now(),
        orderNumber: `#${appState.nextOrderCounter++}`,
        customer,
        channel,
        createdAt: Date.now(),
        items: JSON.parse(JSON.stringify(kdsBuilderCart))
      });

      saveState();
      refreshAllViews();
      showToast('Comanda enviada para a fila da Cozinha (KDS)!', 'info');
    }

    function dispatchBuilderImmediately() {
      if (kdsBuilderCart.length === 0) {
        showToast('Adicione pelo menos 1 item ao pedido!', 'warning');
        return;
      }
      const customer = document.getElementById('kdsCustomerName').value.trim() || 'Balcão Rápido';
      const channel = document.getElementById('kdsOrderChannel').value;
      const tempOrder = {
        id: 'direct_' + Date.now(),
        orderNumber: `#${appState.nextOrderCounter++}`,
        customer,
        channel,
        createdAt: Date.now(),
        items: JSON.parse(JSON.stringify(kdsBuilderCart))
      };

      executeOrderStockDeduction(tempOrder);
    }

    // Executa a baixa automática no estoque e grava no histórico financeiro
    function executeOrderStockDeduction(order) {
      const breakdown = aggregateOrderIngredients(order.items);
      let totalCost = 0;
      const deductionsLog = [];

      // Desconta cada ingrediente do estoque
      breakdown.forEach(entry => {
        const ing = entry.ingredient;
        ing.stockBase = Math.max(0, Math.round((ing.stockBase - entry.baseNeeded) * 100) / 100);
        totalCost += entry.cost;

        const baseSymbol = getBaseUnitSymbol(ing.baseType);
        deductionsLog.push({
          ingredientId: ing.id,
          name: ing.name,
          baseType: ing.baseType,
          baseDeducted: entry.baseNeeded,
          displayDeducted: `${entry.baseNeeded.toLocaleString('pt-BR')} ${baseSymbol}`,
          cost: Math.round(entry.cost * 100) / 100
        });
      });

      // Calcula receita bruta e resumo dos itens
      let revenue = 0;
      const summaryParts = [];
      order.items.forEach(oi => {
        const rec = appState.recipes.find(r => r.id === oi.recipeId);
        if (rec) {
          revenue += rec.price * oi.qty;
          summaryParts.push(`${oi.qty}x ${rec.name}`);
        }
      });

      // Registra no Ledger de Relatórios
      appState.logs.unshift({
        id: 'log_' + Date.now() + '_' + Math.random().toString(36).substring(2, 6),
        orderNumber: order.orderNumber,
        customer: order.customer,
        channel: order.channel,
        timestamp: Date.now(),
        revenue: Math.round(revenue * 100) / 100,
        totalCost: Math.round(totalCost * 100) / 100,
        itemsSummary: summaryParts.join(', '),
        deductions: deductionsLog
      });

      // Remove da fila se estava na fila
      appState.kdsQueue = appState.kdsQueue.filter(q => q.id !== order.id);

      saveState();
      refreshAllViews();

      // Mostra notificação detalhada
      const sampleDeductions = deductionsLog.slice(0, 3).map(d => `-${d.displayDeducted} ${d.name.split(' ')[0]}`).join(', ');
      showToast(
        `Pedido ${order.orderNumber} despachado! Estoque atualizado (${sampleDeductions}...) • CMV: ${formatCurrency(totalCost)}`,
        'success'
      );
    }

