    function saveIngredientForm(e) {
      e.preventDefault();
      const id = document.getElementById('ingFormId').value;
      const name = document.getElementById('ingFormName').value.trim();
      const category = document.getElementById('ingFormCategory').value;
      const displayUnit = document.getElementById('ingFormUnit').value;
      const qtyInput = parseFloat(document.getElementById('ingFormQty').value) || 0;
      const minInput = parseFloat(document.getElementById('ingFormMinQty').value) || 0;
      const costInput = parseFloat(document.getElementById('ingFormCost').value) || 0;

      const baseType = getBaseType(displayUnit);
      const stockBase = toBaseAmount(qtyInput, displayUnit);
      const minBase = toBaseAmount(minInput, displayUnit);
      const costPerBase = (displayUnit === 'kg' || displayUnit === 'L') ? (costInput / 1000) : costInput;

      if (id) {
        const existing = appState.ingredients.find(i => i.id === id);
        if (existing) {
          existing.name = name;
          existing.category = category;
          existing.baseType = baseType;
          existing.displayUnit = displayUnit;
          existing.stockBase = stockBase;
          existing.minBase = minBase;
          existing.costPerBase = costPerBase;
        }
        showToast(`Insumo "${name}" atualizado com sucesso!`, 'success');
      } else {
        appState.ingredients.push({
          id: 'ing_' + Date.now(),
          name,
          category,
          baseType,
          displayUnit,
          stockBase,
          minBase,
          costPerBase
        });
        showToast(`Novo insumo "${name}" adicionado ao estoque!`, 'success');
      }

      saveState();
      closeIngredientModal();
      refreshAllViews();
    }

