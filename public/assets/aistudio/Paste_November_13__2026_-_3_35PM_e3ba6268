    function updateUnitHelperText() {
      const unit = document.getElementById('ingFormUnit').value;
      const costLabel = document.getElementById('ingFormCostLabel');
      const preview = document.getElementById('ingFormConversionPreview');

      const labels = {
        'kg': 'Custo por Quilo (R$ / kg) *',
        'g': 'Custo por Grama (R$ / g) *',
        'L': 'Custo por Litro (R$ / L) *',
        'ml': 'Custo por Mililitro (R$ / ml) *',
        'un': 'Custo por Unidade (R$ / un) *'
      };
      costLabel.textContent = labels[unit] || 'Custo Unitário (R$) *';

      if (unit === 'kg') {
        preview.innerHTML = `Cadastrando em <strong>kg</strong>: se você colocar <strong>2</strong>, o sistema registra <strong>2.000g</strong> internos para descontar pedidos em gramas.`;
      } else if (unit === 'g') {
        preview.innerHTML = `Cadastrando em <strong>gramas (g)</strong>: ideal para porções e hortifruti como tomate, alface e temperos.`;
      } else if (unit === 'L') {
        preview.innerHTML = `Cadastrando em <strong>Litros (L)</strong>: cada 1 L equivale a <strong>1.000 ml</strong> para descontar molhos em ml.`;
      } else if (unit === 'ml') {
        preview.innerHTML = `Cadastrando em <strong>Mililitros (ml)</strong>: desconto direto por ml em cada pedido.`;
      } else {
        preview.innerHTML = `Cadastrando por <strong>Unidade (un)</strong>: ideal para carnes de hambúrguer, pães e embalagens.`;
      }
    }

