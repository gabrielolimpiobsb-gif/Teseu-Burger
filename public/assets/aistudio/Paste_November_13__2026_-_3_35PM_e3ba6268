<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Teseu Burger — Sistema de Estoque, Fichas Técnicas & KDS</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <!-- Google Fonts: Cinzel (Clássico Grego-Romano) & Inter (Leitura SaaS) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            teseu: {
              crimson: '#710912',
              crimsonDark: '#4e050b',
              gold: '#C28D39',
              goldLight: '#dfc18d',
              cream: '#EFE5D2',
              creamLight: '#F8F4EC',
              dark: '#1A1615',
              surface: '#241E1C'
            }
          },
          fontFamily: {
            display: ['Cinzel', 'serif'],
            sans: ['Inter', 'sans-serif']
          }
        }
      }
    }
  </script>

  <style>
    body {
      background-color: #EFE5D2;
      color: #1A1615;
      font-family: 'Inter', sans-serif;
    }
    .font-olympus {
      font-family: 'Cinzel', serif;
    }
    .gold-border {
      border: 1px solid rgba(194, 141, 57, 0.45);
    }
    .gold-glow:hover {
      box-shadow: 0 6px 20px -4px rgba(194, 141, 57, 0.35);
    }
    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }
    ::-webkit-scrollbar-track {
      background: #EFE5D2;
    }
    ::-webkit-scrollbar-thumb {
      background: #C28D39;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #710912;
    }
    @keyframes pulseSubtle {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.02); }
    }
    .animate-subtle {
      animation: pulseSubtle 2.5s infinite ease-in-out;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col selection:bg-teseu-crimson selection:text-white">

  <!-- TOP HEADER -->
  <header class="bg-teseu-dark text-white border-b-2 border-teseu-gold sticky top-0 z-30 shadow-lg">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex flex-col md:flex-row md:items-center md:justify-between gap-3">
      
      <!-- Brand Identity -->
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-11 h-11 rounded-xl bg-teseu-crimson border-2 border-teseu-gold flex items-center justify-center shadow-md">
            <i class="fa-solid fa-fire-flame-curved text-teseu-gold text-xl"></i>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <h1 class="font-olympus text-xl sm:text-2xl font-bold tracking-wider text-teseu-gold">TESEU BURGER</h1>
              <span class="text-[11px] uppercase tracking-widest px-2 py-0.5 rounded-full bg-teseu-crimson text-teseu-cream border border-teseu-gold/50 font-semibold">Admin ERP</span>
            </div>
            <p class="text-xs text-stone-300">Controle de Insumos por Grama/Quilo/ML/Unidade & Baixa Automática KDS</p>
          </div>
        </div>

        <!-- Mobile Reset Button -->
        <button onclick="openResetModal()" title="Restaurar dados de fábrica" class="md:hidden text-xs px-2.5 py-1.5 rounded-lg border border-teseu-gold/40 text-teseu-gold hover:bg-teseu-gold/10">
          <i class="fa-solid fa-rotate-left"></i>
        </button>
      </div>

      <!-- Quick Live Metrics Bar -->
      <div class="flex flex-wrap items-center gap-2 sm:gap-4">
        <div class="bg-teseu-surface px-3 py-1.5 rounded-xl border border-teseu-gold/30 flex items-center gap-2.5">
          <i class="fa-solid fa-Triangle-exclamation text-amber-400 text-sm" id="headerAlertIcon"></i>
          <div class="text-xs">
            <span class="text-stone-400 block">Alertas Críticos</span>
            <span id="headerCriticalCount" class="font-bold text-white">0 insumos</span>
          </div>
        </div>

        <div class="bg-teseu-surface px-3 py-1.5 rounded-xl border border-teseu-gold/30 flex items-center gap-2.5">
          <i class="fa-solid fa-sack-dollar text-teseu-gold text-sm"></i>
          <div class="text-xs">
            <span class="text-stone-400 block">Valor em Estoque</span>
            <span id="headerTotalStockValue" class="font-bold text-teseu-gold">R$ 0,00</span>
          </div>
        </div>

        <div class="bg-teseu-surface px-3 py-1.5 rounded-xl border border-teseu-gold/30 flex items-center gap-2.5">
          <i class="fa-solid fa-receipt text-emerald-400 text-sm"></i>
          <div class="text-xs">
            <span class="text-stone-400 block">Gasto Hoje (CMV)</span>
            <span id="headerTodayCost" class="font-bold text-emerald-400">R$ 0,00</span>
          </div>
        </div>

        <button onclick="openResetModal()" class="hidden md:inline-flex items-center gap-1.5 text-xs px-3 py-2 rounded-xl border border-teseu-gold/40 text-stone-300 hover:text-white hover:bg-teseu-crimson/60 transition">
          <i class="fa-solid fa-rotate-left text-teseu-gold"></i>
          <span>Resetar Demo</span>
        </button>
      </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="bg-teseu-surface/95 border-t border-teseu-gold/20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <nav class="flex space-x-1 sm:space-x-2 overflow-x-auto py-2" aria-label="Tabs">
          <button onclick="switchTab('kds')" id="tab-btn-kds" class="tab-btn flex items-center gap-2 px-4 py-2.5 rounded-xl font-semibold text-xs sm:text-sm whitespace-nowrap transition-all">
            <i class="fa-solid fa-kitchen-set"></i>
            <span>1. Cozinha / KDS (Baixa Automática)</span>
            <span id="kdsQueueBadge" class="ml-1 px-2 py-0.5 text-[11px] rounded-full bg-teseu-gold text-teseu-dark font-bold">3</span>
          </button>

          <button onclick="switchTab('inventory')" id="tab-btn-inventory" class="tab-btn flex items-center gap-2 px-4 py-2.5 rounded-xl font-semibold text-xs sm:text-sm whitespace-nowrap transition-all">
            <i class="fa-solid fa-boxes-stacked"></i>
            <span>2. Estoque de Insumos (g, kg, ml, un)</span>
          </button>

          <button onclick="switchTab('recipes')" id="tab-btn-recipes" class="tab-btn flex items-center gap-2 px-4 py-2.5 rounded-xl font-semibold text-xs sm:text-sm whitespace-nowrap transition-all">
            <i class="fa-solid fa-burger"></i>
            <span>3. Fichas Técnicas (Cardápio Teseu)</span>
          </button>

          <button onclick="switchTab('reports')" id="tab-btn-reports" class="tab-btn flex items-center gap-2 px-4 py-2.5 rounded-xl font-semibold text-xs sm:text-sm whitespace-nowrap transition-all">
            <i class="fa-solid fa-chart-pie"></i>
            <span>4. Relatórios de Gastos (Dia/Sem/Mês/Ano)</span>
          </button>
        </nav>
      </div>
    </div>
  </header>

  <!-- MAIN WORKSPACE -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">

    <!-- ========================================================== -->
    <!-- MODULE 1: COZINHA / SIMULADOR KDS (BAIXA AUTOMÁTICA)       -->
    <!-- ========================================================== -->
    <section id="tab-kds" class="tab-section space-y-6">
      <!-- Explainer Banner -->
      <div class="bg-gradient-to-r from-teseu-crimson to-teseu-dark text-white rounded-2xl p-5 shadow-md border border-teseu-gold flex flex-col lg:flex-row lg:items-center justify-between gap-4">
        <div class="space-y-1">
          <div class="inline-flex items-center gap-2 text-xs uppercase tracking-widest text-teseu-gold font-bold">
            <i class="fa-solid fa-bolt"></i> Integração Cozinha &rarr; Estoque em Tempo Real
          </div>
          <h2 class="font-olympus text-xl sm:text-2xl font-bold">Simulador de Pedidos na Cozinha (KDS)</h2>
          <p class="text-xs sm:text-sm text-stone-200 max-w-3xl">
            Quando um pedido sai na cozinha, o sistema converte e desconta automaticamente cada ingrediente na medida exata (ex: desconta <strong>250g</strong> dos <strong>2kg de batata</strong>, <strong>10g de tomate</strong>, <strong>1 un de carne</strong>) e registra o custo no relatório financeiro.
          </p>
        </div>
        <div class="flex flex-wrap gap-2 shrink-0">
          <button onclick="addSimulatedQueueOrder()" class="px-4 py-2.5 rounded-xl bg-teseu-gold text-teseu-dark font-bold text-xs sm:text-sm hover:bg-teseu-goldLight transition shadow flex items-center gap-2">
            <i class="fa-solid fa-plus-circle"></i> Gerar Pedido Aleatório na Fila
          </button>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        
        <!-- Left Column: Custom Order Builder (5 cols) -->
        <div class="lg:col-span-5 bg-teseu-creamLight rounded-2xl p-5 gold-border shadow-sm flex flex-col justify-between space-y-4">
          <div class="space-y-4">
            <div class="flex items-center justify-between border-b border-teseu-gold/30 pb-3">
              <div>
                <h3 class="font-olympus font-bold text-lg text-teseu-crimson flex items-center gap-2">
                  <i class="fa-solid fa-cash-register text-teseu-gold"></i> Lançar Pedido Manual / PDV
                </h3>
                <p class="text-xs text-stone-600">Monte uma comanda e veja a prévia exata do desconto no estoque</p>
              </div>
              <span class="text-xs font-semibold px-2.5 py-1 rounded-lg bg-teseu-crimson/10 text-teseu-crimson" id="builderOrderNumber">#1042</span>
            </div>

            <!-- Customer / Table Input -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label class="block text-xs font-semibold text-stone-700 mb-1">Cliente / Identificação</label>
                <input type="text" id="kdsCustomerName" value="Mesa 07 - Perseu" placeholder="Ex: Mesa 04 / iFood" class="w-full px-3 py-2 rounded-xl border border-stone-300 bg-white text-sm focus:outline-none focus:border-teseu-crimson" />
              </div>
              <div>
                <label class="block text-xs font-semibold text-stone-700 mb-1">Canal do Pedido</label>
                <select id="kdsOrderChannel" class="w-full px-3 py-2 rounded-xl border border-stone-300 bg-white text-sm focus:outline-none focus:border-teseu-crimson">
                  <option value="Salão Olímpico">Salão Olímpico</option>
                  <option value="Delivery App">Delivery App</option>
                  <option value="Retirada Balcão">Retirada Balcão</option>
                </select>
              </div>
            </div>

            <!-- Select Menu Items -->
            <div>
              <label class="block text-xs font-semibold text-stone-700 mb-1.5">Adicionar Itens do Cardápio Teseu</label>
              <div class="flex gap-2">
                <select id="kdsRecipeSelect" class="flex-1 px-3 py-2 rounded-xl border border-stone-300 bg-white text-sm focus:outline-none focus:border-teseu-crimson"></select>
                <input type="number" id="kdsRecipeQty" value="1" min="1" max="20" class="w-16 px-2 py-2 rounded-xl border border-stone-300 bg-white text-center text-sm font-bold" />
                <button onclick="addItemToBuilder()" class="px-3.5 py-2 rounded-xl bg-teseu-crimson text-white font-semibold text-sm hover:bg-teseu-crimsonDark transition flex items-center gap-1">
                  <i class="fa-solid fa-plus"></i> Add
                </button>
              </div>
            </div>

            <!-- Current Cart List -->
            <div class="bg-white rounded-xl p-3 border border-stone-200 space-y-2 max-h-48 overflow-y-auto" id="kdsBuilderCartList">
              <!-- Populated by JS -->
            </div>

            <!-- Real-time Stock Deduction Preview -->
            <div class="bg-teseu-dark text-white rounded-xl p-3.5 border border-teseu-gold/50 space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold uppercase tracking-wider text-teseu-gold flex items-center gap-1.5">
                  <i class="fa-solid fa-scale-balanced"></i> Prévia de Desconto no Estoque:
                </span>
                <span id="kdsPreviewTotalCost" class="text-xs font-bold text-emerald-400">CMV Total: R$ 0,00</span>
              </div>
              <div id="kdsDeductionPreviewList" class="space-y-1.5 max-h-48 overflow-y-auto pr-1 text-xs">
                <!-- Populated by JS -->
              </div>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="pt-2 grid grid-cols-1 sm:grid-cols-2 gap-2.5">
            <button onclick="sendBuilderToQueue()" class="w-full py-2.5 px-4 rounded-xl border-2 border-teseu-crimson text-teseu-crimson font-bold text-xs sm:text-sm hover:bg-teseu-crimson hover:text-white transition flex items-center justify-center gap-2">
              <i class="fa-solid fa-clock"></i> Enviar p/ Fila KDS
            </button>
            <button onclick="dispatchBuilderImmediately()" class="w-full py-2.5 px-4 rounded-xl bg-emerald-700 text-white font-bold text-xs sm:text-sm hover:bg-emerald-800 transition shadow flex items-center justify-center gap-2">
              <i class="fa-solid fa-check-double"></i> Dar Saída Agora
            </button>
          </div>
        </div>

        <!-- Right Column: Active KDS Kitchen Tickets + Live Log (7 cols) -->
        <div class="lg:col-span-7 flex flex-col gap-6">
          
          <!-- Active Kitchen Queue -->
          <div class="bg-teseu-creamLight rounded-2xl p-5 gold-border shadow-sm space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-teseu-gold/30 pb-3">
              <div>
                <h3 class="font-olympus font-bold text-lg text-teseu-dark flex items-center gap-2">
                  <i class="fa-solid fa-fire-burner text-teseu-crimson"></i> Comandas na Cozinha (Aguardando Saída)
                </h3>
                <p class="text-xs text-stone-600">Clique em <strong>"Dar Saída & Descontar Estoque"</strong> quando o pedido ficar pronto</p>
              </div>
              <button onclick="dispatchAllKdsQueue()" id="btnDispatchAll" class="text-xs px-3 py-1.5 rounded-xl bg-teseu-crimson text-white font-semibold hover:bg-teseu-crimsonDark transition self-start sm:self-auto">
                <i class="fa-solid fa-bolt mr-1"></i> Despachar Todos da Fila
              </button>
            </div>

            <div id="kdsActiveQueueContainer" class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <!-- Active Tickets Rendered by JS -->
            </div>
          </div>

          <!-- Recent Deductions Feed -->
          <div class="bg-teseu-dark text-white rounded-2xl p-5 border border-teseu-gold/40 shadow-sm space-y-3">
            <div class="flex items-center justify-between">
              <h4 class="font-olympus text-sm font-bold text-teseu-gold flex items-center gap-2">
                <i class="fa-solid fa-clock-rotate-left"></i> Últimas Baixas Automáticas Realizadas
              </h4>
              <button onclick="switchTab('reports')" class="text-xs text-teseu-goldLight underline hover:text-white">
                Ver Relatório Completo &rarr;
              </button>
            </div>
            <div id="kdsRecentLogsContainer" class="space-y-2 max-h-52 overflow-y-auto pr-1">
              <!-- Populated by JS -->
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ========================================================== -->
    <!-- MODULE 2: ESTOQUE DE INSUMOS (CONVERSÃO INTELIGENTE)       -->
    <!-- ========================================================== -->
    <section id="tab-inventory" class="tab-section hidden space-y-6">
      
      <!-- Top Controls & Smart Unit Explanation -->
      <div class="bg-teseu-creamLight rounded-2xl p-5 gold-border shadow-sm flex flex-col lg:flex-row lg:items-center justify-between gap-4">
        <div class="space-y-1">
          <div class="flex items-center gap-2">
            <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-teseu-crimson text-white">Motor de Conversão Automática</span>
            <span class="text-xs text-stone-600 font-medium">1 kg = 1.000 g &bull; 1 L = 1.000 ml &bull; un = unidade</span>
          </div>
          <h2 class="font-olympus text-xl sm:text-2xl font-bold text-teseu-dark">Estoque de Insumos & Matéria-Prima</h2>
          <p class="text-xs sm:text-sm text-stone-600">
            Cadastre seus produtos em <strong>Quilos (kg)</strong>, <strong>Gramas (g)</strong>, <strong>Litros (L)</strong>, <strong>Mililitros (ml)</strong> ou <strong>Unidades (un)</strong>. Se você tiver 2kg de batata e sair um pedido com 250g, o estoque passa para <strong>1,75 kg (1.750 g)</strong> automaticamente.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-2.5 shrink-0">
          <button onclick="openNewIngredientModal()" class="px-4 py-2.5 rounded-xl bg-teseu-crimson text-white font-bold text-xs sm:text-sm hover:bg-teseu-crimsonDark transition shadow flex items-center gap-2">
            <i class="fa-solid fa-plus"></i> Cadastrar Novo Insumo
          </button>
        </div>
      </div>

      <!-- Filter & Search Bar -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 bg-white p-3.5 rounded-2xl gold-border">
        <div class="relative flex-1">
          <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-stone-400 text-sm"></i>
          <input type="text" id="inventorySearchInput" oninput="renderInventory()" placeholder="Buscar insumo (ex: carne, batata, tomate, cheddar, pão...)" class="w-full pl-9 pr-4 py-2 rounded-xl border border-stone-200 text-sm focus:outline-none focus:border-teseu-crimson" />
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <select id="inventoryCategoryFilter" onchange="renderInventory()" class="px-3 py-2 rounded-xl border border-stone-200 text-xs sm:text-sm bg-white font-medium">
            <option value="ALL">Todas as Categorias</option>
            <option value="Carnes & Proteínas">Carnes & Proteínas</option>
            <option value="Pães & Massas">Pães & Massas</option>
            <option value="Queijos & Laticínios">Queijos & Laticínios</option>
            <option value="Hortifruti">Hortifruti</option>
            <option value="Congelados & Fritos">Congelados & Fritos</option>
            <option value="Molhos & Condimentos">Molhos & Condimentos</option>
            <option value="Embalagens">Embalagens</option>
          </select>

          <select id="inventoryStatusFilter" onchange="renderInventory()" class="px-3 py-2 rounded-xl border border-stone-200 text-xs sm:text-sm bg-white font-medium">
            <option value="ALL">Todos os Status</option>
            <option value="CRITICAL">Apenas Estoque Crítico / Baixo</option>
            <option value="OK">Estoque Normal</option>
          </select>
        </div>
      </div>

      <!-- Inventory Table -->
      <div class="bg-white rounded-2xl gold-border shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-teseu-dark text-teseu-gold text-xs uppercase tracking-wider">
                <th class="py-3.5 px-4 font-semibold">Insumo / Categoria</th>
                <th class="py-3.5 px-4 font-semibold">Saldo Atual (Principal)</th>
                <th class="py-3.5 px-4 font-semibold">Conversão Base (g/ml/un)</th>
                <th class="py-3.5 px-4 font-semibold">Mínimo Alerta</th>
                <th class="py-3.5 px-4 font-semibold">Custo Pago</th>
                <th class="py-3.5 px-4 font-semibold">Valor em Estoque</th>
                <th class="py-3.5 px-4 font-semibold text-right">Ações Rápidas</th>
              </tr>
            </thead>
            <tbody id="inventoryTableBody" class="divide-y divide-stone-200 text-sm">
              <!-- Populated by JS -->
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ========================================================== -->
    <!-- MODULE 3: FICHAS TÉCNICAS (CARDÁPIO TESEU BURGER)          -->
    <!-- ========================================================== -->
    <section id="tab-recipes" class="tab-section hidden space-y-6">
      <div class="bg-teseu-creamLight rounded-2xl p-5 gold-border shadow-sm flex flex-col lg:flex-row lg:items-center justify-between gap-4">
        <div class="space-y-1">
          <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-teseu-gold text-teseu-dark">Engenharia de Cardápio & CMV</span>
          <h2 class="font-olympus text-xl sm:text-2xl font-bold text-teseu-dark">Fichas Técnicas — Lanches & Porções Teseu Burger</h2>
          <p class="text-xs sm:text-sm text-stone-600">
            Configure exatamente quantas <strong>gramas (g)</strong>, <strong>mililitros (ml)</strong> ou <strong>unidades (un)</strong> cada produto consome quando é vendido. O cálculo de CMV (Custo de Mercadoria Vendida) e margem é atualizado automaticamente.
          </p>
        </div>

        <button onclick="openRecipeModal()" class="px-4 py-2.5 rounded-xl bg-teseu-crimson text-white font-bold text-xs sm:text-sm hover:bg-teseu-crimsonDark transition shadow flex items-center gap-2 self-start lg:self-auto shrink-0">
          <i class="fa-solid fa-plus"></i> Nova Ficha Técnica (Produto)
        </button>
      </div>

      <!-- Recipes Grid -->
      <div id="recipesGridContainer" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        <!-- Populated by JS -->
      </div>
    </section>

    <!-- ========================================================== -->
    <!-- MODULE 4: RELATÓRIOS DE GASTOS (DIÁRIO, SEMANAL, MENSAL, ANUAL) -->
    <!-- ========================================================== -->
    <section id="tab-reports" class="tab-section hidden space-y-6">
      
      <!-- Period Selector Header -->
      <div class="bg-teseu-dark text-white rounded-2xl p-5 border border-teseu-gold shadow-md flex flex-col lg:flex-row lg:items-center justify-between gap-4">
        <div>
          <span class="text-xs uppercase tracking-widest text-teseu-gold font-bold">Auditoria Financeira de Insumos</span>
          <h2 class="font-olympus text-xl sm:text-2xl font-bold">Relatório de Gastos & Consumo de Estoque</h2>
          <p class="text-xs sm:text-sm text-stone-300">
            Acompanhe quanto você está gastando em mercadoria consumida por período: <strong>Diário, Semanal, Mensal e Anual</strong>.
          </p>
        </div>

        <!-- Period Filter Buttons -->
        <div class="flex flex-wrap items-center gap-1.5 bg-teseu-surface p-1.5 rounded-xl border border-teseu-gold/40">
          <button onclick="setReportPeriod('DAILY')" id="period-btn-DAILY" class="period-btn px-3.5 py-2 rounded-lg text-xs font-bold transition">
            Hoje (Diário)
