  <!-- ========================================================== -->
  <!-- APPLICATION JAVASCRIPT & SMART UNIT ENGINE                 -->
  <!-- ========================================================== -->
  <script>
    const STORAGE_KEY = 'TESEU_BURGER_ERP_V1';

    // Current UI states
    let activeTab = 'kds';
    let activeReportPeriod = 'DAILY';
    let kdsBuilderCart = [];
    let recipeModalDraftItems = [];

    // ============================================================================
    // 1. CONVERSOR INTELIGENTE DE MEDIDAS (g <-> kg, ml <-> L, un)
    // ============================================================================
    function getBaseType(unit) {
      if (unit === 'kg' || unit === 'g') return 'mass';     // Base interna: gramas (g)
      if (unit === 'L' || unit === 'ml') return 'volume';   // Base interna: mililitros (ml)
      return 'unit';                                        // Base interna: unidades (un)
    }

    function toBaseAmount(qty, unit) {
      const n = parseFloat(qty) || 0;
      if (unit === 'kg' || unit === 'L') return Math.round(n * 1000 * 100) / 100;
      return Math.round(n * 100) / 100;
    }

    function fromBaseAmount(baseQty, displayUnit) {
      const n = parseFloat(baseQty) || 0;
      if (displayUnit === 'kg' || displayUnit === 'L') {
        return Math.round((n / 1000) * 1000) / 1000;
      }
      return Math.round(n * 100) / 100;
    }

    function getBaseUnitSymbol(baseType) {
      if (baseType === 'mass') return 'g';
      if (baseType === 'volume') return 'ml';
      return 'un';
    }

    // Formata exibições amigáveis como "1,75 kg (1.750 g)"
    function formatDualStock(baseQty, preferredUnit, baseType) {
      const baseSymbol = getBaseUnitSymbol(baseType);
      if (preferredUnit === 'kg' || preferredUnit === 'L') {
        const mainVal = (baseQty / 1000).toLocaleString('pt-BR', { minimumFractionDigits: 0, maximumFractionDigits: 3 });
        const subVal = Math.round(baseQty).toLocaleString('pt-BR');
        return {
          primary: `${mainVal} ${preferredUnit}`,
          secondary: `${subVal} ${baseSymbol}`
        };
      } else {
        const subVal = Math.round(baseQty).toLocaleString('pt-BR');
        if (baseType === 'mass' && baseQty >= 1000) {
          const kgVal = (baseQty / 1000).toLocaleString('pt-BR', { maximumFractionDigits: 2 });
          return { primary: `${subVal} g`, secondary: `equiv. ${kgVal} kg` };
        }
        if (baseType === 'volume' && baseQty >= 1000) {
          const lVal = (baseQty / 1000).toLocaleString('pt-BR', { maximumFractionDigits: 2 });
          return { primary: `${subVal} ml`, secondary: `equiv. ${lVal} L` };
        }
        return { primary: `${subVal} ${baseSymbol}`, secondary: `Medida exata` };
      }
    }

    function formatCurrency(val) {
      return (parseFloat(val) || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
    }

    // ============================================================================
    // 2. DADOS INICIAIS REALISTAS (INCLUINDO O EXEMPLO EXATO DO USUÁRIO)
    // ============================================================================
    function getInitialData() {
      const now = Date.now();
      const hour = 3600 * 1000;
      const day = 24 * hour;

      // Insumos pré-cadastrados (incluindo 5 carnes de hambúrguer, 2kg de batata, tomate em gramas, etc.)
      const ingredients = [
        {
          id: 'ing_carne',
          name: 'Carne de Hambúrguer (Blend 160g)',
          category: 'Carnes & Proteínas',
          baseType: 'unit',
          displayUnit: 'un',
