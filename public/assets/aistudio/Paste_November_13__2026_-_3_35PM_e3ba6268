                  <i class="fa-solid fa-trash"></i>
                </button>
              </div>
            </div>
          </div>
        `;
      }).join('');
    }

    function quickSimulateRecipeSale(recipeId) {
      const rec = appState.recipes.find(r => r.id === recipeId);
      if (!rec) return;
      executeOrderStockDeduction({
        id: 'quick_' + Date.now(),
        orderNumber: `#${appState.nextOrderCounter++}`,
        customer: 'Venda Rápida Cardápio',
        channel: 'Balcão Teseu',
        createdAt: Date.now(),
        items: [{ recipeId: rec.id, qty: 1 }]
      });
    }

    function openRecipeModal() {
      document.getElementById('recipeModalTitle').textContent = 'Nova Ficha Técnica Teseu Burger';
      document.getElementById('recipeFormId').value = '';
      document.getElementById('recipeFormName').value = '';
      document.getElementById('recipeFormPrice').value = '';
      document.getElementById('recipeFormDesc').value = '';
      recipeModalDraftItems = [];

      populateRecipeIngSelector();
      renderRecipeDraftItems();

      const modal = document.getElementById('recipeModal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function openEditRecipeModal(recipeId) {
      const rec = appState.recipes.find(r => r.id === recipeId);
      if (!rec) return;

      document.getElementById('recipeModalTitle').textContent = `Editar Ficha: ${rec.name}`;
      document.getElementById('recipeFormId').value = rec.id;
      document.getElementById('recipeFormName').value = rec.name;
      document.getElementById('recipeFormPrice').value = rec.price;
      document.getElementById('recipeFormDesc').value = rec.description || '';
      recipeModalDraftItems = JSON.parse(JSON.stringify(rec.items));

      populateRecipeIngSelector();
      renderRecipeDraftItems();

      const modal = document.getElementById('recipeModal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeRecipeModal() {
      const modal = document.getElementById('recipeModal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    function populateRecipeIngSelector() {
      const sel = document.getElementById('recipeIngSelect');
      sel.innerHTML = appState.ingredients.map(i => `<option value="${i.id}">${i.name}</option>`).join('');
      syncRecipeIngUnitOptions();
    }

    function syncRecipeIngUnitOptions() {
      const ingId = document.getElementById('recipeIngSelect').value;
      const ing = appState.ingredients.find(i => i.id === ingId);
      const unitSel = document.getElementById('recipeIngUnit');
      if (!ing) return;

      if (ing.baseType === 'mass') {
        unitSel.innerHTML = `<option value="g">g (gramas)</option><option value="kg">kg (quilos)</option>`;
        unitSel.value = 'g';
      } else if (ing.baseType === 'volume') {
        unitSel.innerHTML = `<option value="ml">ml (mililitros)</option><option value="L">L (litros)</option>`;
        unitSel.value = 'ml';
      } else {
        unitSel.innerHTML = `<option value="un">un (unidade)</option>`;
        unitSel.value = 'un';
      }
    }

    function addIngredientToRecipeDraft() {
      const ingredientId = document.getElementById('recipeIngSelect').value;
      const qty = parseFloat(document.getElementById('recipeIngQty').value) || 0;
      const unit = document.getElementById('recipeIngUnit').value;
      if (!ingredientId || qty <= 0) {
        showToast('Informe a quantidade do insumo a ser descontada!', 'warning');
        return;
      }

      const existing = recipeModalDraftItems.find(i => i.ingredientId === ingredientId);
      if (existing) {
        existing.qty = qty;
        existing.unit = unit;
      } else {
        recipeModalDraftItems.push({ ingredientId, qty, unit });
      }
      document.getElementById('recipeIngQty').value = '';
      renderRecipeDraftItems();
    }

    function removeRecipeDraftItem(idx) {
      recipeModalDraftItems.splice(idx, 1);
      renderRecipeDraftItems();
    }

    function renderRecipeDraftItems() {
      const listEl = document.getElementById('recipeDraftItemsList');
      let totalCmv = 0;

      if (recipeModalDraftItems.length === 0) {
        listEl.innerHTML = `<p class="text-xs text-stone-400 py-3 text-center">Nenhum ingrediente vinculado ainda.</p>`;
      } else {
        listEl.innerHTML = recipeModalDraftItems.map((item, idx) => {
          const ing = appState.ingredients.find(i => i.id === item.ingredientId);
          if (!ing) return '';
          const baseNeed = toBaseAmount(item.qty, item.unit);
          const cost = baseNeed * ing.costPerBase;
          totalCmv += cost;
          return `
            <div class="flex items-center justify-between py-2 text-xs">
              <div>
                <strong class="text-teseu-dark">${ing.name}</strong>
                <span class="ml-2 px-2 py-0.5 rounded bg-stone-100 font-bold text-teseu-crimson">-${item.qty} ${item.unit}</span>
              </div>
              <div class="flex items-center gap-3">
                <span class="font-semibold text-stone-600">${formatCurrency(cost)}</span>
                <button type="button" onclick="removeRecipeDraftItem(${idx})" class="text-stone-400 hover:text-red-600">
                  <i class="fa-solid fa-trash"></i>
                </button>
              </div>
            </div>
          `;
        }).join('');
      }

      document.getElementById('recipeModalLiveCmv').textContent = formatCurrency(totalCmv);
    }

    function saveRecipeForm(e) {
      e.preventDefault();
      if (recipeModalDraftItems.length === 0) {
        showToast('Adicione pelo menos 1 insumo na ficha técnica!', 'warning');
        return;
      }

      const id = document.getElementById('recipeFormId').value;
      const name = document.getElementById('recipeFormName').value.trim();
      const price = parseFloat(document.getElementById('recipeFormPrice').value) || 0;
      const description = document.getElementById('recipeFormDesc').value.trim();

      if (id) {
        const rec = appState.recipes.find(r => r.id === id);
        if (rec) {
          rec.name = name;
          rec.price = price;
          rec.description = description;
          rec.items = JSON.parse(JSON.stringify(recipeModalDraftItems));
        }
        showToast(`Ficha Técnica "${name}" atualizada!`, 'success');
      } else {
        appState.recipes.push({
          id: 'rec_' + Date.now(),
          name,
          price,
          description,
          items: JSON.parse(JSON.stringify(recipeModalDraftItems))
        });
        showToast(`Nova Ficha Técnica "${name}" criada!`, 'success');
      }

      saveState();
      closeRecipeModal();
      refreshAllViews();
    }

    function deleteRecipe(recipeId) {
      appState.recipes = appState.recipes.filter(r => r.id !== recipeId);
      saveState();
      refreshAllViews();
      showToast('Ficha técnica removida.', 'info');
    }

    // ============================================================================
    // 7. MÓDULO DE RELATÓRIOS (DIÁRIO, SEMANAL, MENSAL E ANUAL)
    // ============================================================================
    function setReportPeriod(period) {
      activeReportPeriod = period;
      renderReports();
    }

    function getLogsForPeriod(periodKey) {
      const now = Date.now();
      const day = 24 * 3600 * 1000;
      const startOfToday = new Date();
      startOfToday.setHours(0, 0, 0, 0);

      if (periodKey === 'DAILY') {
        return appState.logs.filter(l => l.timestamp >= startOfToday.getTime());
      }
      if (periodKey === 'WEEKLY') {
        return appState.logs.filter(l => l.timestamp >= (now - 7 * day));
      }
      if (periodKey === 'MONTHLY') {
        return appState.logs.filter(l => l.timestamp >= (now - 30 * day));
      }
      // YEARLY (365 days)
      return appState.logs.filter(l => l.timestamp >= (now - 365 * day));
    }

    function renderReports() {
      // Highlight period button
      ['DAILY', 'WEEKLY', 'MONTHLY', 'YEARLY'].forEach(p => {
        const btn = document.getElementById(`period-btn-${p}`);
        if (!btn) return;
        if (p === activeReportPeriod) {
          btn.className = 'period-btn px-3.5 py-2 rounded-lg text-xs font-bold transition bg-teseu-gold text-teseu-dark shadow';
        } else {
          btn.className = 'period-btn px-3.5 py-2 rounded-lg text-xs font-bold transition text-stone-300 hover:text-white';
        }
      });

      // Update the 4 summary boxes (Diário, Semanal, Mensal, Anual simultaneously)
      const sumCost = logs => logs.reduce((acc, l) => acc + l.totalCost, 0);
      document.getElementById('summaryBoxDaily').textContent = formatCurrency(sumCost(getLogsForPeriod('DAILY')));
      document.getElementById('summaryBoxWeekly').textContent = formatCurrency(sumCost(getLogsForPeriod('WEEKLY')));
      document.getElementById('summaryBoxMonthly').textContent = formatCurrency(sumCost(getLogsForPeriod('MONTHLY')));
      document.getElementById('summaryBoxYearly').textContent = formatCurrency(sumCost(getLogsForPeriod('YEARLY')));

      const periodLogs = getLogsForPeriod(activeReportPeriod);
      const totalCost = sumCost(periodLogs);
      const totalRevenue = periodLogs.reduce((acc, l) => acc + (l.revenue || 0), 0);
      const cmvPct = totalRevenue > 0 ? Math.round((totalCost / totalRevenue) * 100) : 0;

      const labelMap = {
        DAILY: 'GASTO HOJE (DIÁRIO)',
        WEEKLY: 'GASTO 7 DIAS (SEMANAL)',
        MONTHLY: 'GASTO 30 DIAS (MENSAL)',
        YEARLY: 'GASTO 12 MESES (ANUAL)'
      };
      document.getElementById('kpiPeriodLabelCost').textContent = labelMap[activeReportPeriod];
      document.getElementById('kpiTotalCost').textContent = formatCurrency(totalCost);
      document.getElementById('kpiTotalRevenue').textContent = formatCurrency(totalRevenue);
      document.getElementById('kpiCmvPercentage').textContent = `CMV Médio no período: ${cmvPct}%`;
      document.getElementById('kpiOrdersCount').textContent = `${periodLogs.length} ${periodLogs.length === 1 ? 'pedido' : 'pedidos'}`;

      // Aggregate ingredient consumption across periodLogs
      const ingUsageMap = {};
      periodLogs.forEach(log => {
        log.deductions.forEach(d => {
          if (!ingUsageMap[d.ingredientId]) {
            ingUsageMap[d.ingredientId] = {
              name: d.name,
              baseType: d.baseType,
              totalBaseDeducted: 0,
              totalCost: 0
            };
          }
          ingUsageMap[d.ingredientId].totalBaseDeducted += d.baseDeducted;
          ingUsageMap[d.ingredientId].totalCost += d.cost;
        });
      });

      const usageList = Object.values(ingUsageMap).sort((a, b) => b.totalCost - a.totalCost);

      // Top ingredient KPI
      if (usageList.length > 0) {
        document.getElementById('kpiTopIngredientName').textContent = usageList[0].name;
        document.getElementById('kpiTopIngredientValue').textContent = `${formatCurrency(usageList[0].totalCost)} consumidos`;
      } else {
        document.getElementById('kpiTopIngredientName').textContent = 'Nenhum consumo';
        document.getElementById('kpiTopIngredientValue').textContent = 'R$ 0,00';
      }

      // Render Ingredient Breakdown Bar Chart
      const breakdownEl = document.getElementById('reportIngredientBreakdown');
      if (usageList.length === 0) {
        breakdownEl.innerHTML = `<p class="text-xs text-stone-400 py-6 text-center">Nenhum insumo descontado neste período.</p>`;
      } else {
        const maxCost = Math.max(...usageList.map(u => u.totalCost), 1);
        breakdownEl.innerHTML = usageList.map(u => {
          const pct = Math.min(100, Math.round((u.totalCost / maxCost) * 100));
          const baseSym = getBaseUnitSymbol(u.baseType);
          let qtyFormatted = `${u.totalBaseDeducted.toLocaleString('pt-BR')} ${baseSym}`;
          if (u.baseType === 'mass' && u.totalBaseDeducted >= 1000) {
            qtyFormatted += ` (${(u.totalBaseDeducted / 1000).toLocaleString('pt-BR', { maximumFractionDigits: 2 })} kg)`;
          } else if (u.baseType === 'volume' && u.totalBaseDeducted >= 1000) {
            qtyFormatted += ` (${(u.totalBaseDeducted / 1000).toLocaleString('pt-BR', { maximumFractionDigits: 2 })} L)`;
          }

          return `
            <div class="space-y-1 bg-stone-50 p-3 rounded-xl border border-stone-200">
              <div class="flex items-center justify-between text-xs">
                <strong class="text-teseu-dark">${u.name}</strong>
                <span class="font-extrabold text-teseu-crimson">${formatCurrency(u.totalCost)}</span>
              </div>
              <div class="w-full bg-stone-200 h-2 rounded-full overflow-hidden">
                <div class="bg-teseu-crimson h-full rounded-full" style="width: ${pct}%"></div>
              </div>
              <div class="flex items-center justify-between text-[11px] text-stone-500">
                <span>Total Descontado: <strong class="text-stone-700">${qtyFormatted}</strong></span>
                <span>${Math.round((u.totalCost / (totalCost || 1)) * 100)}% do gasto do período</span>
              </div>
            </div>
          `;
        }).join('');
      }

      // Render Ledger List
      const ledgerEl = document.getElementById('reportLedgerList');
      if (periodLogs.length === 0) {
        ledgerEl.innerHTML = `<p class="text-xs text-stone-400 py-6 text-center">Nenhum pedido registrado neste período.</p>`;
      } else {
        ledgerEl.innerHTML = periodLogs.map(log => {
          const dt = new Date(log.timestamp);
          const dateFormatted = dt.toLocaleDateString('pt-BR') + ' às ' + dt.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
          const deductionsText = log.deductions.map(d => `-${d.displayDeducted} ${d.name.split(' ')[0]}`).join(' • ');

          return `
            <div class="p-3 rounded-xl border border-stone-200 bg-stone-50 space-y-1 text-xs">
              <div class="flex items-center justify-between">
                <span class="font-bold text-teseu-crimson">${log.orderNumber} — ${log.customer}</span>
                <strong class="text-teseu-dark">CMV: ${formatCurrency(log.totalCost)}</strong>
              </div>
              <div class="text-stone-700 font-medium">${log.itemsSummary}</div>
              <div class="text-[11px] text-stone-500">${deductionsText}</div>
              <div class="text-[10px] text-stone-400 pt-0.5">${dateFormatted} &bull; Venda: ${formatCurrency(log.revenue)}</div>
            </div>
          `;
        }).join('');
      }
    }

    function simulateHistoricalBatch() {
      if (appState.recipes.length === 0) return;
      const rec = appState.recipes[0];
      executeOrderStockDeduction({
        id: 'sim_' + Date.now(),
        orderNumber: `#${appState.nextOrderCounter++}`,
        customer: 'Simulação Rápida Relatório',
        channel: 'Salão Olímpico',
        createdAt: Date.now(),
        items: [{ recipeId: rec.id, qty: 2 }]
      });
    }

    function exportReportCSV() {
      const periodLogs = getLogsForPeriod(activeReportPeriod);
      if (periodLogs.length === 0) {
        showToast('Não há registros neste período para exportar.', 'warning');
        return;
      }

      let csv = 'Pedido,Data,Cliente,Itens,Custo_Insumos_R$,Venda_Bruta_R$,Insumos_Descontados\n';
      periodLogs.forEach(l => {
        const dt = new Date(l.timestamp).toLocaleString('pt-BR');
        const deds = l.deductions.map(d => `${d.displayDeducted} ${d.name}`).join(' | ');
        csv += `"${l.orderNumber}","${dt}","${l.customer}","${l.itemsSummary}","${l.totalCost.toFixed(2)}","${(l.revenue || 0).toFixed(2)}","${deds}"\n`;
      });

      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `relatorio_estoque_teseu_${activeReportPeriod.toLowerCase()}.csv`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      showToast('Planilha CSV exportada com sucesso!', 'success');
    }

    // ============================================================================
    // 8. RESET DEMO & NOTIFICAÇÕES TOAST
    // ============================================================================
    function openResetModal() {
      const m = document.getElementById('resetModal');
      m.classList.remove('hidden');
      m.classList.add('flex');
    }

    function closeResetModal() {
      const m = document.getElementById('resetModal');
      m.classList.add('hidden');
      m.classList.remove('flex');
    }

    function confirmResetDemo() {
      appState = getInitialData();
      kdsBuilderCart = [];
      saveState(appState);
      closeResetModal();
      refreshAllViews();
      showToast('Dados de demonstração restaurados (5 carnes, 2kg de batata, etc.)!', 'success');
    }

    function showToast(message, type = 'success') {
      const container = document.getElementById('toastContainer');
      const toast = document.createElement('div');

      const styles = {
        success: 'bg-teseu-dark border-l-4 border-emerald-500 text-white',
        warning: 'bg-teseu-dark border-l-4 border-amber-500 text-white',
        info: 'bg-teseu-dark border-l-4 border-teseu-gold text-white'
      };
      const icons = {
        success: 'fa-circle-check text-emerald-400',
        warning: 'fa-triangle-exclamation text-amber-400',
        info: 'fa-bell text-teseu-gold'
      };

      toast.className = `${styles[type] || styles.success} p-3.5 rounded-xl shadow-xl flex items-start gap-3 pointer-events-auto transition-all duration-300`;
      toast.innerHTML = `
        <i class="fa-solid ${icons[type] || icons.success} mt-0.5 text-base"></i>
        <div class="text-xs leading-relaxed flex-1">${message}</div>
      `;

      container.appendChild(toast);
      setTimeout(() => {
        toast.style.opacity = '0';
        setTimeout(() => toast.remove(), 300);
      }, 4200);
    }

    // Inicializa na carga da janela
    window.onload = function () {
      switchTab('kds');
    };
  </script>
